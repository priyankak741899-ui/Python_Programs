   "source": [
    " # Replace All Vowels in UpperCase"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "f1b4e0d3-a831-4a67-bf8b-a7462d04052d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a string: priyanka\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Result= prIyAnkA\n"
     ]
    }
   ],
   "source": [
    "s=input(\"Enter a string:\")\n",
    "result=\"\"\n",
    "for ch in s:\n",
    "    if ch.lower() in \"aeiou\":\n",
    "        result+=ch.upper()\n",
    "    else:\n",
    "        result+=ch\n",
    "print(\"Result=\",result)        \n",
    "    "
   ]
  },
