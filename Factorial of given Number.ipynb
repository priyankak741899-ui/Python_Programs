   "source": [
    "# Factorial of given Number "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "dc8806f8-fecb-470a-8a00-a09704b8d98f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      "Enter a number: 3\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Factorial= 6\n"
     ]
    }
   ],
   "source": [
    "n=int(input(\"Enter a number:\"))\n",
    "fact=1\n",
    "for i in range(1, n+1):\n",
    "    fact=fact*i\n",
    "print(\"Factorial=\", fact)    "
   ]
