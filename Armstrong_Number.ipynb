   "source": [
    "# Armstrong number "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "27fbf254-45f9-4424-96f9-9e495a0efa40",
   "metadata": {},
   "outputs": [],
   "source": [
    "n=int(input(\"Enter a number:\"))\n",
    "temp=n\n",
    "sum=0\n",
    "while temp>0:\n",
    "    digit=temp%10\n",
    "    sum=sum+digit**3\n",
    "    temp=temp//10\n",
    "if sum==n:\n",
    "    print(\"Armstrong Number\")\n",
    "else:\n",
    "    print(\"Not an Armstrong Number\")"
   ]
  },
